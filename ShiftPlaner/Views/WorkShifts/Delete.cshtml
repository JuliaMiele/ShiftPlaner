@model ShiftPlaner.Models.WorkShift
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Schicht löschen";
}

<h1>Schicht löschen</h1>

<div class="alert alert-warning">
    Möchtest du diese Schicht wirklich löschen?
</div>

<dl class="row">
    <dt class="col-sm-3">Datum</dt>
    <dd class="col-sm-9">@Model.Date.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Beginn</dt>
    <dd class="col-sm-9">@Model.StartTime.ToString("HH:mm")</dd>

    <dt class="col-sm-3">Ende</dt>
    <dd class="col-sm-9">@Model.EndTime.ToString("HH:mm")</dd>

    <dt class="col-sm-3">Schichttyp</dt>
    <dd class="col-sm-9">@Model.ShiftType</dd>

    <dt class="col-sm-3">Notiz</dt>
    <dd class="col-sm-9">@Model.Note</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Endgültig löschen
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Abbrechen
    </a>
</form>